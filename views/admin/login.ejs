<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Syne:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #080a0e; --gold: #c9a84c; --gold2: #e8c97a;
      --text: #e8e4d8; --text-muted: #8a8680; --border: rgba(201,168,76,0.2);
      --surface: #0d1117;
    }
    body {
      background: var(--bg); color: var(--text); font-family: 'Syne', sans-serif;
      min-height: 100vh; display: flex; align-items: center; justify-content: center;
      background-image: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(201,168,76,0.04) 0%, transparent 70%);
    }
    .login-box {
      width: 420px; border: 1px solid var(--border); background: var(--surface);
      padding: 3.5rem; position: relative;
    }
    .login-box::before {
      content: ''; position: absolute; top: -1px; left: 10%; right: 10%;
      height: 2px; background: linear-gradient(90deg, transparent, var(--gold), transparent);
    }
    .login-logo {
      font-family: 'DM Mono', monospace; font-size: 0.7rem; letter-spacing: 0.3em;
      color: var(--gold); text-transform: uppercase; text-align: center; margin-bottom: 2.5rem;
    }
    h1 { font-size: 1.75rem; font-weight: 700; text-align: center; margin-bottom: 0.5rem; }
    p { font-family: 'DM Mono', monospace; font-size: 0.72rem; color: var(--text-muted); text-align: center; margin-bottom: 2.5rem; letter-spacing: 0.1em; }
    .form-group { margin-bottom: 1.5rem; }
    label { font-family: 'DM Mono', monospace; font-size: 0.68rem; letter-spacing: 0.2em; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 0.5rem; }
    input {
      width: 100%; background: transparent; border: 1px solid var(--border);
      color: var(--text); font-family: 'Syne', sans-serif; font-size: 0.95rem;
      padding: 0.9rem 1rem; outline: none; transition: border-color 0.3s;
    }
    input:focus { border-color: var(--gold); }
    button {
      width: 100%; background: transparent; border: 1px solid var(--gold);
      color: var(--gold); font-family: 'DM Mono', monospace; font-size: 0.75rem;
      letter-spacing: 0.2em; text-transform: uppercase; padding: 1rem;
      cursor: pointer; position: relative; overflow: hidden; transition: color 0.4s;
      margin-top: 0.5rem;
    }
    button::before { content: ''; position: absolute; inset: 0; background: var(--gold); transform: translateX(-101%); transition: transform 0.4s cubic-bezier(0.4,0,0.2,1); }
    button:hover { color: #080a0e; }
    button:hover::before { transform: translateX(0); }
    button span { position: relative; z-index: 1; }
    .error { background: rgba(220,50,50,0.1); border: 1px solid rgba(220,50,50,0.4); color: #e88080; font-family: 'DM Mono', monospace; font-size: 0.75rem; padding: 0.75rem 1rem; margin-bottom: 1.5rem; letter-spacing: 0.1em; }
    a { color: var(--text-muted); text-decoration: none; font-family: 'DM Mono', monospace; font-size: 0.7rem; letter-spacing: 0.12em; display: block; text-align: center; margin-top: 1.5rem; transition: color 0.3s; }
    a:hover { color: var(--gold); }
  </style>
</head>
<body>
  <div class="login-box">
    <div class="login-logo">✦ Admin Panel</div>
    <h1>Welcome Back</h1>
    <p>Sign in to manage your portfolio</p>
    <% if (error) { %><div class="error">✕ <%= error %></div><% } %>
    <form method="POST" action="/admin/login">
      <div class="form-group">
        <label>Username</label>
        <input type="text" name="username" placeholder="admin" required />
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="••••••••" required />
      </div>
      <button type="submit"><span>Sign In ✦</span></button>
    </form>
    <a href="/">← Back to Portfolio</a>
  </div>
</body>
</html>
